# ============================================
# JWT Secret Configuration
# ============================================
# MUST BE 32+ characters (256 bits minimum)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-here-must-be-32-chars-or-more

# ============================================
# Google OAuth (Optional)
# ============================================
GOOGLE_CLIENT_ID=237372892439-4bju17u6k3cjoil26p148m21ilmecd9s.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=237372892439-79qbbfmfu7j54ds45nae883b378en7jb.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=237372892439-7qjqf6cpjlk2bfi7o39donf5g8krk5k2.apps.googleusercontent.com
GOOGLE_DESKTOP_CLIENT_ID=237372892439-qq82sddn0nkjbjbgi0f6hl2ap1i0qnss.apps.googleusercontent.com
# ============================================
# Email Configuration (Optional)
# ============================================
MAIL_HOST=smtp.mail.ru
MAIL_PORT=465
MAIL_USERNAME=your-email@mail.ru
MAIL_PASSWORD=your-mail-app-password

# ============================================
# SMS Configuration (Optional)
# ============================================
ESKIZ_EMAIL=your-eskiz-email
ESKIZ_PASSWORD=your-eskiz-password

# ============================================
# Telegram Bot
# ============================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=your-telegram-bot-username
TELEGRAM_WEBHOOK_URL=
TELEGRAM_BASE_URL=https://pravaonline.uz

# ============================================
# CORS — comma-separated allowed origins
# ============================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,https://pravaonline.uz,https://www.pravaonline.uz,https://admin.pravaonline.uz

# ============================================
# Default staff akkauntlarini bootstrap qilish
# ============================================
# Default: O'CHIQ. Faqat birinchi o'rnatishda true qiling, keyin yana false.
# Har bir akkaunt faqat paroli (>=12 belgi) berilgan va email bazada YO'Q bo'lsa
# yaratiladi. Mavjud akkauntlarning paroli/roli HECH QACHON o'zgartirilmaydi.
# NOTE: parolda "$" bo'lsa, docker-compose uchun "$$" deb yozing.
APP_INIT_DEFAULT_USERS_ENABLED=false
APP_INIT_SUPER_ADMIN_PASSWORD=change-me-strong-password
APP_INIT_ADMIN_PASSWORD=change-me-strong-password

# ============================================
# Desktop litsenziya imzolash kaliti (Ed25519)  [AUDIT: yangi]
# ============================================
# Bu 32 baytli seed desktop ilova aktivatsiya tokenlarini IMZOLAYDI.
# Avval u Ed25519LicenseService.java ichida hardcoded turgan, ya'ni git
# repo'ga tushgan edi — uni bilgan har kim cheksiz soxta litsenziya
# generatsiya qila oladi. Eski kalitni KOMPROMETATSIYA QILINGAN deb hisoblang.
#
# Yangi kalit generatsiya qilish:   openssl rand -base64 32
# Format: base64 (standart yoki url-safe) yoki 64 belgili hex.
#
# DIQQAT: kalitni almashtirsangiz, desktop ilovadagi (activation.rs) mos
# PUBLIC kalitni ham yangilab, yangi build tarqatishingiz SHART — aks holda
# yangi tokenlar eski klientlarda ishlamaydi.
# MAJBURIY: bo'sh bo'lsa litsenziya imzolash o'chiriladi (eski leaked kalit endi ishlatilmaydi).
LICENSE_ED25519_SEED=

# ============================================
# Database (prod)  [AUDIT: yangi]
# ============================================
# application-prod.yaml da `prava_password` default'i hali ham bor, lekin u
# git'da ochiq — ya'ni komprometatsiya qilingan. Parolni almashtiring, bu
# yerga yozing, so'ng application-prod.yaml dagi default'ni olib tashlang.
DB_URL=jdbc:postgresql://postgres:5432/prava_online_db
DB_USERNAME=prava_user
DB_PASSWORD=

# ============================================
# To'lov tizimlari (Click / Payme)
# ============================================
# PAYMENT_ENABLED=true   # default: true (application.yaml)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_CASHBOX_KEY=
PAYME_TEST_CASHBOX_KEY=
# Sandbox kaliti faqat true bo'lganda qabul qilinadi. Prod profilda true bo'lsa ilova ishga tushmaydi.
PAYME_TEST_MODE=false

# ============================================
# Telegram webhook secret (MAJBURIY — bo'sh bo'lsa webhook barcha so'rovlarni rad etadi)
# ============================================
# Generatsiya: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
